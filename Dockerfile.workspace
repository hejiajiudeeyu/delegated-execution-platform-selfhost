FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/platform-console/package.json apps/platform-console/package.json
COPY apps/platform-api/package.json apps/platform-api/package.json
COPY apps/platform-console-gateway/package.json apps/platform-console-gateway/package.json
COPY apps/transport-relay/package.json apps/transport-relay/package.json
COPY packages/billing-store/package.json packages/billing-store/package.json
COPY packages/postgres-store/package.json packages/postgres-store/package.json

RUN npm ci --omit=dev \
  && mkdir -p apps/platform-api/node_modules \
    apps/platform-console-gateway/node_modules \
    apps/transport-relay/node_modules

# Build the console SPA (needs devDependencies, so it gets its own stage).
FROM node:22-alpine AS console-build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/platform-console/package.json apps/platform-console/package.json
COPY apps/platform-api/package.json apps/platform-api/package.json
COPY apps/platform-console-gateway/package.json apps/platform-console-gateway/package.json
COPY apps/transport-relay/package.json apps/transport-relay/package.json
COPY packages/billing-store/package.json packages/billing-store/package.json
COPY packages/postgres-store/package.json packages/postgres-store/package.json
RUN npm ci
COPY apps/platform-console ./apps/platform-console
RUN npm run build --workspace @delexec/platform-console

FROM node:22-alpine AS runtime
WORKDIR /app

ARG APP_PATH

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY .docker-local-packages ./.docker-local-packages
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/platform-api/node_modules ./apps/platform-api/node_modules
COPY --from=deps /app/apps/platform-console-gateway/node_modules ./apps/platform-console-gateway/node_modules
COPY --from=deps /app/apps/transport-relay/node_modules ./apps/transport-relay/node_modules
COPY --from=console-build /app/apps/platform-console/dist ./apps/platform-console/dist
RUN if find .docker-local-packages -maxdepth 1 -name "*.tgz" -print -quit | grep -q .; then \
    npm install --omit=dev --package-lock=false ./.docker-local-packages/*.tgz; \
  fi

# Observed build facts (FR-082): injected at image build so a running service
# can report what it actually is, instead of the workspace inferring it.
ARG DELEXEC_BUILD_GIT_SHA=""
ARG DELEXEC_BUILD_AT=""
ARG DELEXEC_RELEASE_ID=""
ARG DELEXEC_RELEASE_MANIFEST_SHA256=""

ENV NODE_ENV=production
ENV DELEXEC_BUILD_GIT_SHA=${DELEXEC_BUILD_GIT_SHA}
ENV DELEXEC_BUILD_AT=${DELEXEC_BUILD_AT}
ENV DELEXEC_RELEASE_ID=${DELEXEC_RELEASE_ID}
ENV DELEXEC_RELEASE_MANIFEST_SHA256=${DELEXEC_RELEASE_MANIFEST_SHA256}
WORKDIR /app/${APP_PATH}
CMD ["npm", "start"]
