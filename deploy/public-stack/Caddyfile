{$PUBLIC_SITE_ADDRESS:http://localhost} {
  encode gzip

  handle /healthz {
    respond "ok" 200
  }

  redir / /console/ 302
  redir /console /console/ 302

  handle_path /platform/* {
    reverse_proxy platform-api:8080
  }

  # Relay business endpoints (send/poll/ack/peek) are unauthenticated and must
  # stay internal-only; only the health probe is exposed at the edge.
  handle /relay/healthz {
    rewrite * /healthz
    reverse_proxy relay:8090
  }

  handle /relay/* {
    respond "relay is internal-only" 403
  }

  handle_path /gateway/* {
    reverse_proxy platform-console-gateway:8085
  }

  handle_path /console/* {
    reverse_proxy platform-console-gateway:8085
  }
}
